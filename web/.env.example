# Server-side only (Vercel: Project → Settings → Environment Variables).
# Leave ANTHROPIC_API_KEY unset to run with the offline demo parser.
ANTHROPIC_API_KEY=
# Optional access code. When set, visitors must enter it before the AI is used,
# so a public URL can't run up the API bill.
DEMO_PASSWORD=
ANTHROPIC_MODEL=claude-opus-5-5
