# Leave unset to run in offline demo mode (rule-based parser, no AI).
ANTHROPIC_API_KEY=
# Shared password for the demo (any username). Set this before sharing a public URL.
DEMO_PASSWORD=
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
PORT=4400
# HOST=0.0.0.0           # listen on all interfaces (the Dockerfile sets this)
# RATE_LIMIT_PER_MIN=20  # AI captures per visitor IP per minute
